# Sidrat Mobile Environment Variables
# Copy this to .env and fill in your values.
# These are loaded by Expo via EXPO_PUBLIC_ prefix.
#
# IMPORTANT: Never commit .env to git. The .gitignore already excludes it.

# Environment: development | preview | production
EXPO_PUBLIC_ENV=development

# Supabase (https://supabase.com → project settings → API)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Sentry (https://sentry.io → project settings → DSN)
EXPO_PUBLIC_SENTRY_DSN=

# PostHog Analytics (https://posthog.com → project settings)
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
